{
  "name": "@zshoham/teaman",
  "version": "1.6.0",
  "description": "Static site generator for Obsidian vaults (Astro engine).",
  "type": "module",
  "bin": {
    "teaman": "./bin/teaman.mjs"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zshoham/teaman.git"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "resources",
    "slidev-theme-teaman",
    "astro.config.mjs",
    "components.json",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "bun bin/teaman.mjs dev ./example",
    "build": "bun run build:all",
    "build:astro": "bun --bun astro build",
    "preview": "bun bin/teaman.mjs preview ./example --out public",
    "build:references": "bun scripts/build-references.mjs",
    "build:slides": "bun scripts/build-slides.mjs",
    "build:search": "bun scripts/build-search.mjs",
    "build:all": "bun bin/teaman.mjs build ./example --out public",
    "typecheck": "bun --bun astro sync && bun ./node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:doctor": "bun --bun vitest doctor",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "bun scripts/integration-test.mjs",
    "sync:confluence": "bun scripts/sync-confluence.mjs",
    "build:binary": "bun scripts/build-binary.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@base-ui/react": "^1.8.0",
    "@d2lang/d2": "0.1.34",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@plantuml/core": "^1.2026.8",
    "@slidev/cli": "^53.0.0",
    "@slidev/parser": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.50.0",
    "markdown-it": "^14.1.1",
    "mermaid": "^12.1.0",
    "node-tikzjax": "^1.0.5",
    "oxc-transform-react": "0.152.0",
    "pagefind": "^1.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-callouts": "^2.2.0",
    "rehype-slug": "^6.0.0",
    "remark-wiki-link": "^2.0.1",
    "semver": "^7.8.5",
    "shadcn": "^4.21.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "happy-dom": "^20.14.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
