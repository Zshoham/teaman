---
import { SITE_CONFIG } from '../config';
import { ThemeToggle } from './ThemeToggle';
import { NavMenu } from './NavMenu';
import { Whiteboard } from './Whiteboard';
import { isSectionActive, loadNavSections } from '../lib/nav';

const base = import.meta.env.BASE_URL;
const logoUrl = SITE_CONFIG.logo ? `${base}${SITE_CONFIG.logo}` : null;

const sections = await loadNavSections();
const pathname = Astro.url.pathname;
const activeId = sections.find(section => isSectionActive(section, pathname))?.id;

// Below `xl` the content sections (notes/references/guides/slides) collapse into one
// dropdown so the header keeps a single nav row; daily/decisions stay inline.
// Below `lg` the nav drops to its own row under the brand: the bracketed links,
// the labelled search box and the tagline do not fit one row at tablet widths.
const grouped = sections.filter(section => section.grouped);
const standalone = sections.filter(section => !section.grouped);

// The active section is bracketed like the current tab in a TUI tab bar:
// `[notes/]`. Every link carries its brackets, transparent until hovered or
// active, so moving between sections never shifts the row.
const linkClass = (id: string) => [
  'group min-h-11 items-center md:min-h-0 font-mono text-meta-lg no-underline transition-colors',
  id === activeId ? 'text-foreground' : 'text-muted-foreground hover:text-foreground',
];
const bracketClass = (id: string) => [
  'transition-colors',
  id === activeId ? 'text-primary' : 'text-transparent group-hover:text-faint',
];
---

<header
  id="site-header"
  data-pagefind-ignore="all"
  class="sticky top-0 z-30 grid min-w-0 grid-cols-[minmax(0,1fr)_auto] gap-x-4 gap-y-1 border-b border-border bg-background py-2 md:gap-y-2 md:pt-4 md:pb-3 lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] lg:gap-6 lg:pt-7 lg:pb-5"
>
  <a href={base} class="brand min-w-0 flex items-center gap-2.5 text-foreground no-underline">
    {logoUrl
      ? <span
          class="inline-block h-5 w-5 bg-current"
          style={`--brand-logo: url('${logoUrl}'); -webkit-mask: var(--brand-logo) center / contain no-repeat; mask: var(--brand-logo) center / contain no-repeat;`}
          aria-hidden="true"
        ></span>
      : <span class="inline-block h-2.5 w-2.5 rounded-sm bg-primary" aria-hidden="true"></span>
    }
    <span class="brand-name truncate font-mono text-meta-lg font-medium tracking-wide">{SITE_CONFIG.brand}</span>
    <span class="brand-cursor -ml-2 inline-block text-meta-lg h-[1.1em] w-[0.55em] shrink-0 bg-primary" aria-hidden="true"></span>
    <span class="brand-tagline ml-1 min-w-0 truncate font-mono text-meta text-faint">~ {SITE_CONFIG.tagline}</span>
  </a>

  <nav
    class="section-nav col-span-2 row-start-2 flex min-w-0 items-center justify-start gap-1 lg:col-span-1 lg:col-start-2 lg:row-start-1 lg:justify-center"
    aria-label="Sections"
  >
    {grouped.length > 0 && (
      <div class="xl:hidden">
        <NavMenu
          items={grouped.map(({ id, label, href }) => ({ id, label, href }))}
          activeId={activeId}
          client:load
        />
      </div>
    )}

    {grouped.map(section => (
      <a
        href={section.href}
        class:list={['hidden xl:inline-flex', ...linkClass(section.id)]}
        aria-current={section.id === activeId ? 'page' : undefined}
        data-nav-section={section.id}
      ><span class:list={bracketClass(section.id)} aria-hidden="true">[</span>{section.label}<span aria-hidden="true">/</span><span class:list={bracketClass(section.id)} aria-hidden="true">]</span></a>
    ))}

    {standalone.map(section => (
      <a
        href={section.href}
        class:list={['inline-flex', ...linkClass(section.id)]}
        aria-current={section.id === activeId ? 'page' : undefined}
        data-nav-section={section.id}
      ><span class:list={bracketClass(section.id)} aria-hidden="true">[</span>{section.label}<span aria-hidden="true">/</span><span class:list={bracketClass(section.id)} aria-hidden="true">]</span></a>
    ))}
  </nav>

  <div class="col-start-2 row-start-1 flex min-w-0 items-center justify-end gap-2 md:gap-3 lg:col-span-1 lg:col-start-3 lg:row-start-1 lg:w-full lg:justify-self-end">
    <pagefind-modal-trigger placeholder="Search the vault">
      <button
        type="button"
        class="flex size-11 justify-center cursor-pointer items-center gap-2.5 md:h-auto rounded-full md:rounded-md border border-border bg-transparent p-0 md:py-1.5 md:pr-2 md:pl-3 font-[inherit] text-foreground transition-colors hover:border-foreground hover:bg-muted outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 md:w-full"
        aria-label="Search the vault"
      >
        <svg class="size-[18px] shrink-0 text-muted-foreground md:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
        <span class="hidden md:block flex-1 min-w-0 text-left font-mono text-meta-lg text-muted-foreground"><span class="text-primary" aria-hidden="true">$</span> grep the vault</span>
        <span class="hidden md:block shrink-0 rounded-sm border border-border bg-background px-1.5 py-[3px] font-mono text-meta-sm leading-none text-faint" aria-hidden="true">/</span>
      </button>
    </pagefind-modal-trigger>

    {/* The whiteboard opens from the header rather than floating over the
        page, where it covered card meta, code-block toolbars and body text.
        It renders client-only, so the slot reserves its size up front. */}
    <span class="header-tool-slot inline-flex shrink-0">
      <Whiteboard assetPath={`${base}excalidraw-assets/`} siteBase={base} client:only="react" />
    </span>
    <ThemeToggle client:load />
  </div>
</header>

<script>
  // Publish the sticky header's height as --header-h so in-page sticky
  // elements (filter bar, week strip, sidebars) can pin just below it
  // rather than sliding underneath. The header wraps to extra rows at
  // narrow widths, so measure it instead of hardcoding a breakpoint value.
  const header = document.getElementById('site-header');
  if (header) {
    const setHeaderH = () =>
      document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
    setHeaderH();
    new ResizeObserver(setHeaderH).observe(header);
  }

  // '/' opens the pagefind modal — matches the kbd hint in the search box.
  window.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target;
    if (t instanceof HTMLElement && (t.matches('input, textarea, [contenteditable], [contenteditable=""]') || t.isContentEditable)) return;
    e.preventDefault();
    document.querySelector('pagefind-modal-trigger button')?.click();
  });
</script>
