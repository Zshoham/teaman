---
import type { QuickLink } from '../../config';
import { computeLayout, type BentoTreatment } from '../../lib/bento';
import { escapeAttr as escapeHtml } from '../../lib/html-escape.mjs';

interface Props {
  links: QuickLink[];
}
const { links } = Astro.props;

// Curated lucide-style stroke icons (24px, currentColor). A `icon` name that
// isn't in this map falls through to rendering the raw string, so an emoji or
// short glyph from config works without an entry here.
const ICONS: Record<string, string> = {
  github:
    '<path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.48 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.4 9.4 0 0 1 12 6.83c.85 0 1.71.12 2.51.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.48A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/>',
  book:
    '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/>',
  globe:
    '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"/>',
  link:
    '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  file:
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M9 13h6"/><path d="M9 17h6"/>',
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  rocket:
    '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09Z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2Z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
  lightbulb:
    '<path d="M15 14c.2-1 .7-2 1.5-2.5C18 10 19 8.5 19 7a7 7 0 1 0-14 0c0 1.5 1 3 2.5 4.5.8.5 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
  mail:
    '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  coffee:
    '<path d="M10 2v2"/><path d="M14 2v2"/><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"/><path d="M6 2v2"/>',
  'arrow-up-right': '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>',
};

// Icons are built as markup strings rather than inline JSX because every tile
// draws its glyph at two or three sizes (watermark, inline, external arrow) —
// one builder beats three near-identical <svg> blocks per treatment.
function iconMarkup(name: string, size: number, cls: string): string {
  const body = ICONS[name];
  if (!body) {
    // Not a curated name: render the config string verbatim (emoji / glyph).
    // The size goes out as a custom property rather than `font-size` directly —
    // an inline declaration would beat the class rules that step the watermark
    // down on narrow viewports, which is the whole point of those rules.
    return `<span class="${cls}" style="--ql-glyph-size:${Math.round(size * 0.8)}px;line-height:1">${escapeHtml(name)}</span>`;
  }
  return `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="${cls}" aria-hidden="true">${body}</svg>`;
}

function arrowMarkup(size: number): string {
  return `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ql-ext" aria-hidden="true">${ICONS['arrow-up-right']}</svg>`;
}

// Literal class strings (no interpolation) so Tailwind's content scanner sees
// every variant and generates the CSS. The desktop span comes from the bento
// layout; the narrower breakpoints come from the treatment instead, since a
// 6-col span means nothing on a phone.
const MD_SPAN = [
  'md:col-span-1',
  'md:col-span-2',
  'md:col-span-3',
  'md:col-span-4',
  'md:col-span-5',
  'md:col-span-6',
];
const BASE_SPAN: Record<BentoTreatment, string> = {
  feature: 'col-span-1 sm:col-span-4',
  mid: 'col-span-1 sm:col-span-2',
};

const { cards, chips } = computeLayout(links);

// The bento packing guarantees full rows on the 6-col `md` grid only. At `sm`
// the grid is 4 columns — mids take 2, the feature takes all 4 — where exactly
// one hole is possible: an odd number of mids ahead of the feature leaves half
// a row behind when the feature wraps to its own line. Stretch that last mid
// across instead. (Nothing after the feature can hole: mids pair up, and a
// trailing odd one ends the grid rather than sitting next to a gap.)
const featurePos = cards.findIndex((c) => c.treatment === 'feature');
const smStretch = featurePos % 2 === 1 ? featurePos - 1 : -1;

function isExternal(url: string): boolean {
  return /^https?:\/\//i.test(url);
}

/** Feature-tile kicker: the host for an external link, the path for an in-site one. */
function destination(url: string): string {
  if (!isExternal(url)) return url;
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}
---

<div class="quick-links" data-quick-links>
  {cards.length > 0 && (
    <section class="grid grid-cols-1 gap-3 sm:grid-cols-4 md:grid-cols-6">
      {cards.map((card, i) => {
        const l = links[card.link];
        const ext = isExternal(l.url);
        const icon = l.icon ?? 'link';
        const cls = [
          'quick-link',
          `quick-link-${card.treatment}`,
          i === smStretch ? 'col-span-1 sm:col-span-4' : BASE_SPAN[card.treatment],
          MD_SPAN[card.cols - 1],
        ];
        const target = ext ? { target: '_blank', rel: 'noopener noreferrer' } : {};

        if (card.treatment === 'feature') {
          return (
            <a href={l.url} class:list={cls} {...target}>
              <Fragment set:html={iconMarkup(icon, 190, 'ql-watermark')} />
              <span class="ql-kicker">
                {destination(l.url)}
                {ext && <Fragment set:html={arrowMarkup(11)} />}
              </span>
              <span class="ql-name">{l.label}</span>
              {l.description && <p class="ql-desc">{l.description}</p>}
            </a>
          );
        }

        return (
          <a href={l.url} class:list={cls} {...target}>
            <Fragment set:html={iconMarkup(icon, 96, 'ql-watermark')} />
            <span class="ql-name">
              {l.label}
              {ext && <Fragment set:html={arrowMarkup(12)} />}
            </span>
            {l.description && <p class="ql-desc">{l.description}</p>}
          </a>
        );
      })}
    </section>
  )}

  {chips.length > 0 && (
    <nav class="quick-strip" aria-label="Other links">
      {chips.map(i => {
        const l = links[i];
        const ext = isExternal(l.url);
        return (
          <a
            href={l.url}
            class="quick-chip"
            {...ext ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
          >
            <Fragment set:html={iconMarkup(l.icon ?? 'link', 15, 'ql-glyph')} />
            <span class="ql-name">{l.label}</span>
            {ext && <Fragment set:html={arrowMarkup(11)} />}
          </a>
        );
      })}
    </nav>
  )}
</div>
