---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config';
import { Breadcrumbs } from '../../components/Breadcrumbs';
import { GuideTOC } from '../../components/guide/GuideTOC';
import { GuideNav } from '../../components/guide/GuideNav';
import SourceActions from '../../components/SourceActions.astro';
import DocMeta from '../../components/DocMeta.astro';
import { loadGuides, type GuidePage } from '../../lib/guides';
import { readingTimeMeta, wordCount, wordMeta } from '../../lib/text';

export async function getStaticPaths() {
  // `loadGuides` fails the build on a guide it cannot serve, as a broken
  // reference book does and as `doctor` reports.
  const guides = await loadGuides();
  return guides.flatMap(guide => guide.chapters.map((chapter, index) => ({
    // The first chapter is served at the guide root.
    params: { slug: index === 0 ? guide.slug : `${guide.slug}/${chapter.slug}` },
    props: { guide, chapterSlug: chapter.slug },
  })));
}

const { guide, chapterSlug } = Astro.props as { guide: GuidePage; chapterSlug: string };
const idx = guide.chapters.findIndex(c => c.slug === chapterSlug);
const { entry } = guide.chapters[idx];

const { Content } = await render(entry);

const base = import.meta.env.BASE_URL;
const currentTitle = guide.chapters[idx]?.title ?? entry.data.title ?? chapterSlug;
const docTitle = `${currentTitle} — ${guide.title}`;
const words = wordCount(entry.body ?? '');
---

<Layout title={docTitle}>
  <article class="pt-6 pb-2">
    <Breadcrumbs brand={SITE_CONFIG.brand} segments={[
      { label: 'guides', href: `${base}guides/` },
      { label: guide.title, href: `${base}guides/${guide.slug}/` },
      ...(idx > 0 ? [{ label: currentTitle }] : []),
    ]} />

    <div class="grid items-start gap-8 lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-14">
      <GuideTOC guide={guide} currentSlug={chapterSlug} />

      <div class="min-w-0 max-w-[var(--measure)]">
        <header class="mb-8">
          <p class="guide-eyebrow m-0 font-mono text-meta uppercase tracking-label text-faint">guide · chapter {idx + 1} of {guide.chapters.length}</p>
          <h1 class="guide-title doc-title mt-3">{currentTitle}</h1>
          <DocMeta class="mt-4" items={[wordMeta(words), readingTimeMeta(words)]}>
            <SourceActions slot="actions" entry={entry} />
          </DocMeta>
        </header>

        <div class="prose">
          <Content />
        </div>

        <GuideNav guide={guide} currentSlug={chapterSlug} />
      </div>
    </div>
  </article>
</Layout>
