---
import { render } from 'astro:content';
import { getPublished } from '../../lib/published';
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config';
import { Breadcrumbs } from '../../components/Breadcrumbs';
import { ReferenceReader } from '../../components/reference/ReferenceReader';
import DocMeta from '../../components/DocMeta.astro';
import MetaDot from '../../components/MetaDot.astro';
import { fmtDate } from '../../lib/format';
import { readingTimeMeta, wordCount, wordMeta } from '../../lib/text';
import { plural } from '../../lib/text';
import { entryTitle } from '../../lib/entry-title.mjs';

export async function getStaticPaths() {
  const references = await getPublished('references');
  return references.map(reference => ({
    params: { slug: reference.id },
    props: { reference },
  }));
}

const { reference } = Astro.props;
const { Content, headings } = await render(reference);
const base = import.meta.env.BASE_URL;
const words = wordCount(reference.body ?? '');
const title = entryTitle({ data: reference.data, body: reference.body, id: reference.id });
// rehype-autolink-headings appends a visible permalink spelling the heading's
// Markdown marker (`##` on an h2). Astro's rendered heading metadata includes
// that child text, so remove exactly that marker, and no `#` the heading's own
// text ends with, before handing labels to the reader rail.
const withoutMarker = (text: string, depth: number) => {
  const marker = '#'.repeat(depth);
  return (text.endsWith(marker) ? text.slice(0, -marker.length) : text).trim();
};
const tocHeadings = headings
  .filter(heading => heading.depth >= 2 && heading.depth <= 6)
  .map(heading => ({ ...heading, text: withoutMarker(heading.text, heading.depth) }));
const pdfHref = `${base}references/${reference.id}/reference.pdf`;
---

<Layout title={title}>
  <article class="reference-document pt-6 pb-2" data-reference-document>
    <Breadcrumbs brand={SITE_CONFIG.brand} segments={[
      { label: 'references', href: `${base}references/` },
      { label: reference.id },
    ]} />

    <div class="grid items-start gap-8 lg:grid-cols-[minmax(240px,280px)_minmax(0,1fr)] lg:gap-14">
      <ReferenceReader headings={tocHeadings} pdfHref={pdfHref} client:load />

      <div class="min-w-0 max-w-[760px]">
        <header class="mb-10">
          <p class="m-0 font-mono text-meta uppercase tracking-label text-primary">reference document</p>
          <h1 class="reference-title doc-title mt-3 mb-0">{title}</h1>
          {reference.data.summary && (
            <p class="mt-4 max-w-[62ch] font-serif text-lg leading-relaxed text-muted-foreground text-pretty">
              {reference.data.summary}
            </p>
          )}
          <DocMeta
            class="mt-5"
            items={[
              wordMeta(words),
              readingTimeMeta(words),
              plural(tocHeadings.length, 'section'),
            ]}
          >
            {reference.data.date && (
              <time datetime={reference.data.date.toISOString()}>Updated {fmtDate(reference.data.date)}</time>
            )}
            {reference.data.date && reference.data.tags && reference.data.tags.length > 0 && <MetaDot />}
            {reference.data.tags && reference.data.tags.length > 0 && (
              <span class="inline-flex flex-wrap gap-2">
                {reference.data.tags.map(tag => <span class="tracking-wide">#{tag}</span>)}
              </span>
            )}
          </DocMeta>
        </header>

        <div id="reference-content" class="prose reference-prose">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Layout>
